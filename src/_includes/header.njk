<header class="header">
  <div class="container">
    {% if site.logo %}
      <a class="logo" href="/" aria-label="{{ site.title }} home">
        <img src="{{ site.logo }}" alt="" width="930" height="550">
      </a>
    {% endif %}

    {% if site.navigationHeader %}
      <nav class="nav nav--header">
        <ul class="list list--nav">
          {% for item in site.navigationHeader %}
            <li class="item item--nav{% if page.url == item.url %} item--current{% endif %}">
              <a href="{{ item.url }}">{{ item.title }}</a>
            </li>
          {% endfor %}
        </ul>
      </nav>
    {% endif %}
  </div>
</header>
