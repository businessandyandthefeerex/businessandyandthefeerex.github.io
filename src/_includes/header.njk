<header class="header">
  <div class="container">
    {% if site.logo %}
      <a class="logo" href="/" aria-label="{{ site.title }} home">
        <img src="{{ site.logo }}" alt="" width="930" height="550">
      </a>
    {% endif %}

    {% if site.navigationHeader %}
      <nav class="nav nav--header">
        <ul class="list list--nav">
          {% for item in site.navigationHeader %}
            {% set current = page.url == item.url %}
            <li class="item item--nav{% if current %} item--current{% endif %}">
              <a href="{{ item.url }}"{% if current %} aria-current="page"{% endif %}>{{ item.title }}</a>
            </li>
          {% endfor %}
        </ul>
        <button class="button button--nav" type="button" aria-label="Menu toggle" aria-expanded="false">
          {% include "nav-icon.njk" %}
        </button>
      </nav>

      <script>
        const navList = document.querySelector(".header .list--nav");
        const navButton = document.querySelector(".header .button--nav");

        if (navList && navButton) {
          navButton.addEventListener("click", () => {
            const expanded = navButton.getAttribute("aria-expanded") === "true";
            navButton.setAttribute("aria-expanded", String(!expanded));
            navList.classList.toggle("list--nav-open", !expanded);
          });
        }
      </script>
    {% endif %}
  </div>
</header>
