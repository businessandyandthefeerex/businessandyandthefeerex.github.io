---
layout: page.njk
pagination:
  data: collections.locationRegions
  size: 1
  alias: region
permalink: "/country/{{ region.country | slugify }}/region/{{ region.name | slugify }}/"
eleventyComputed:
  title: "{{ region.name }}"
---

{% set countryUrl = "/country/" + (region.country | slugify) + "/" %}
<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/country/">All countries</a> &rsaquo;
  <a href="{{ countryUrl }}">{{ region.country }}</a> &rsaquo;
  <span aria-current="page">{{ region.name }}</span>
</nav>

<h3>Cities</h3>
<ul>
  {% for city in region.cities %}
    <li><a href="/country/{{ region.country | slugify }}/region/{{ region.name | slugify }}/city/{{ city.name | slugify }}/">{{ city.name }}</a></li>
  {% endfor %}
</ul>