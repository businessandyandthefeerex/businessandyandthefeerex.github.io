---
layout: page.njk
pagination:
  data: collections.dateArchives
  size: 1
  alias: archive
permalink: "{{ archive.path }}"
eleventyExcludeFromCollections: true
eleventyComputed:
  title: "Reviews from {{ archive.title }}"
---

{% if (archive.key | length) == 4 %}
  {% for group in archive.reviews | groupByMonth %}
    <h2 class="archive-month-heading"><a href="{{ group.path }}">{{ group.name }}</a></h2>
    <ul>
      {% for review in group.reviews %}
        <li>
          <a href="{{ review.url }}">{{ review.data.title }}</a>
          <span style="font-style: italic; color: #666; font-size: 0.9em;">
          {% if review.data.rating %}Rating: {{ review.data.rating }}{% endif %}
            {{ review.data.date | formatReviewFullDate }}
          </span>
        </li>
      {% endfor %}
    </ul>
  {% endfor %}
{% else %}
  <ul>
    {% for review in archive.reviews %}
      <li>
        <a href="{{ review.url }}">{{ review.data.title }}</a>
        <span style="font-style: italic; color: #666; font-size: 0.9em;">
          {% if review.data.rating %}(Rating: {{ review.data.rating }}){% endif %}
            {{ review.data.date | formatReviewFullDate }}
        </span>
      </li>
    {% endfor %}
  </ul>
{% endif %}