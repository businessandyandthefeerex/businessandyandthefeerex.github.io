---
layout: base.njk
---
{% include "header.njk" %}

<main class="main container">
  <article class="article article--post content typeset">
    <h1>{{ title }}</h1>

    {% set parts = date | dateParts %}
    <small class="small post-meta">
    {% if category %}
    <span class="label label--category">
    {% if category == "Reviews" %}
    <a href="/reviews/">Reviews</a>
    {% else %}
    <a href="/categories/#{{ category | slugify }}">{{ category }}</a>
    {% endif %}
    </span>
    {% endif %}

    {% if parts.day %}
    {% if category %}<span class="meta-separator">&nbsp;&middot;&nbsp;</span>{% endif %}
    <time datetime="{{ date | isoDate }}" class="time">
    <a href="/reviews/{{ parts.year }}/{{ parts.month }}/{{ parts.day }}/">{{ parts.day }}</a>
    <a href="/reviews/{{ parts.year }}/{{ parts.month }}/">{{ parts.monthName }}</a>
    <a href="/reviews/{{ parts.year }}/">{{ parts.year }}</a>
    </time>
    {% endif %}

    {% if country %}
    {% set countryUrl = "/country/" + (country | slugify) + "/" %}
    {% set regionUrl = countryUrl + "region/" + (region | slugify) + "/" %}
    {% set cityUrl = regionUrl + "city/" + (city | slugify) + "/" %}
    {% if category or parts.day %}<span class="meta-separator">&nbsp;&middot;&nbsp;</span>{% endif %}
    <span class="meta-field">
    <a href="{{ countryUrl }}">{{ country }}</a>
    {% if region %} &rsaquo; <a href="{{ regionUrl }}">{{ region }}</a>{% endif %}
    {% if city and region %} &rsaquo; <a href="{{ cityUrl }}">{{ city }}</a>{% endif %}
    {% if suburb and suburb != city and city and region %} &rsaquo; <a href="{{ cityUrl }}suburb/{{ suburb | slugify }}/">{{ suburb }}</a>{% endif %}
    </span>
    {% endif %}
    </small>

    {% if rating %}
      <p><a class="plain-link" href="/rating/{{ rating | slugify }}/">Rating: {{ rating }}</a></p>
    {% endif %}

    {% if parts.year %}
    {% set monthYearLinks %}<a class="plain-link" href="/reviews/{{ parts.year }}/{{ parts.month }}/">{{ parts.monthName }}</a> <a class="plain-link" href="/reviews/{{ parts.year }}/">{{ parts.year }}</a>{% endset %}
    {% endif %}

    {% if meal and parts.year %}
    <p>We ate <a class="plain-link" href="/meal/{{ meal | slugify }}/">{{ meal }}</a> here in {{ monthYearLinks | safe }}.</p>
    {% elif meal %}
    <p>We ate <a class="plain-link" href="/meal/{{ meal | slugify }}/">{{ meal }}</a> here.</p>
    {% elif parts.year %}
    <p>We ate here in {{ monthYearLinks | safe }}.</p>
    {% endif %}

    {% if dishes and dishes.length %}
      <ul class="dishes">
      {% for dish in dishes %}
      <li>{{ dish }}</li>
      {% endfor %}
      </ul>
    {% endif %}

    {{ content | safe }}

    {% set related = collections.reviews | relatedReviews(page.url, title, country, region) %}
    {% if related.length %}
      <section class="related-posts">
        <p>Check out the other times we reviewed {{ title }}:</p>
        <ul>
          {% for review in related %}
            <li>
              <a href="{{ review.url }}">Rating: {{ review.data.rating }}</a>
              <span style="font-style: italic; color: #666; font-size: 0.9em;">
                {{ review.data.date | formatReviewFullDate }}
              </span>
            </li>
          {% endfor %}
        </ul>
      </section>
    {% endif %}

    {% set restaurantWebsite = website | validWebsite %}
    <footer class="post-footer">
      {% if restaurantWebsite %}
        <p>Their <a href="{{ restaurantWebsite }}" target="_blank" rel="noopener noreferrer">website</a></p>
      {% else %}
        <p>{{ title }} has no website.</p>
      {% endif %}
    </footer>
  </article>
</main>

{% include "footer.njk" %}
