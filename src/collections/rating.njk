---
layout: page.njk
pagination:
  data: collections.rating
  size: 1
  alias: rating
permalink: "/rating/{{ rating | slugify }}/"
eleventyComputed:
  title: "Rating: {{ rating }}"
---

<ul>
  {% for review in collections.reviews %}
    {% if review.data.rating | sameValue(rating) %}
      <li><a href="{{ review.url }}">{{ review.data.title }}</a></li>
    {% endif %}
  {% endfor %}
</ul>
