#!/bin/bash
cd "$(git rev-parse --show-toplevel)" || exit 1

# Only run when a review is part of this commit.
if ! git diff --cached --name-only | grep -q '^src/posts/'; then
  exit 0
fi

if ! command -v node &> /dev/null; then
  echo "Node is not installed. Commit aborted."
  exit 1
fi

# 1. Filenames: needs no API key, always runs.
echo "Fixing post filenames..."
npm run --silent fix-filenames || { echo "Filename fix failed. Commit aborted."; exit 1; }
git add -A src/posts

# 2. Geocoding: only if a key is available.
if [ -f .env ] && grep -q '^LOCATIONIQ_KEY=.\+' .env; then
  echo "Geocoding any new addresses..."
  npm run --silent geocode || { echo "Geocoding failed. Commit aborted."; exit 1; }
else
  echo "No LOCATIONIQ_KEY in .env, skipping geocoding. New addresses won't be on the map yet."
fi

# 3. Markers: offline, uses whatever is already geocoded.
echo "Regenerating map markers..."
npm run --silent markers || { echo "Markers script failed. Commit aborted."; exit 1; }

git add assets/geocoded_locations.json assets/markers.json